# ==============================================================================
# LedgerPrime Environment Variables Template
# ==============================================================================
# Copy this file to .env and configure the values before running docker compose.
# Command: cp .env.example .env

# PostgreSQL Database Configuration
POSTGRES_DB=expensetracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# Backend Service Configuration
BACKEND_PORT=8080
# Minimum 64 characters secret required for HS512:
JWT_SECRET=change-this-to-a-long-random-secret-at-least-64-chars-long-for-hs512!!
CORS_ORIGINS=http://localhost:5173
MAIL_ENABLED=false

# Optional Mail / SMTP Configuration (set MAIL_ENABLED=true if using)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# MAIL_FROM=no-reply@yourdomain.com

# Optional AI Monthly Report (BYOK - OpenAI / NVIDIA NIM compatible)
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_MODEL=meta/llama-3.1-70b-instruct
# AI_API_KEY=your_api_key_here
# AI_TIMEOUT_MS=20000
