# ==============================================================================
# Git Ignore for LedgerPrime
# ==============================================================================

# Environment variables & secrets
.env
.env.local
.env.*.local
*.env
!*.env.example
!.env.example
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Java / Maven build artifacts
backend/target/
target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Node / Frontend build artifacts & dependencies
frontend/node_modules/
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker / Persistent volumes
pgdata/
