<settings>
  <!-- Mirror of Maven Central via Google. Use when repo.maven.apache.org
       is unreachable from your network (TLS/ISP block). Serves identical artifacts. -->
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>Google Maven Central Mirror</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
